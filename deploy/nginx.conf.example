# /etc/nginx/conf.d/lulux.conf —— 反代到 docker compose 暴露的 127.0.0.1:51789
server {
    listen 80;
    server_name lulux.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name lulux.example.com;

    ssl_certificate     /etc/letsencrypt/live/lulux.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/lulux.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    client_max_body_size 25m;

    location / {
        proxy_pass http://127.0.0.1:51789;
        proxy_http_version 1.1;
        # Host 必须原样转发：服务端按 LULUX_PUBLIC_ORIGIN 校验 Host
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # SSE：关闭缓冲，长连接
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        proxy_set_header Connection "";
    }
}
